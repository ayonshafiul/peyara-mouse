# Release signing credentials (DO NOT COMMIT - this file is git-ignored).
# Copy this file to `keystore.properties` in the same directory (android/)
# and fill in your values. Place your .jks file in android/app/.
#
# storeFile can be a filename relative to android/app/ (e.g. peyara-release.jks)
# or an absolute path.

storeFile=peyara-release.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
